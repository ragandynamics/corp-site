---
// src/components/assessment/AssessmentStep.astro
import type { Section } from "../../lib/assessment/questions";

export interface Props {
  section: Section;
  stepNumber: number;
  totalSteps: number;
  answers: Record<string, any>;
}

const { section, stepNumber, totalSteps } = Astro.props;
const isLastStep = stepNumber === totalSteps;
---

<div class="flex flex-col space-y-6">

  <!-- Header & Context -->
  <header class="space-y-1.5 border-b border-slate-100 pb-4">
    <div class="flex items-center justify-between text-2xs font-extrabold uppercase tracking-widest text-slate-400">
      <span>Pillar 0{stepNumber} of 0{totalSteps}</span>
      <span class="text-primary font-bold">Confidential Assessment</span>
    </div>
    
    <h2 class="text-xl sm:text-2xl font-heading font-black text-heading tracking-tight leading-snug">
      {section.title}
    </h2>

    {section.description && (
      <p class="text-xs font-body text-slate-500 leading-relaxed max-w-2xl">
        {section.description}
      </p>
    )}
  </header>

  <!-- Questions List -->
  <div class="space-y-6">
    {section.questions.map((q) => (
      <div class="space-y-3" data-question-container={q.id}>
        
        <!-- Question Label with Highlight Arrow / Status Indicator -->
        <div class="space-y-0.5">
          <div class="flex items-start gap-2.5">
            <!-- Dynamic Arrow / Completed Badge -->
            <div class="question-arrow-badge shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center rounded-md bg-primary-50 text-primary border border-primary-100 transition-all duration-300">
              <span class="question-arrow-icon text-xs font-black">→</span>
              <span class="question-check-icon text-xs font-black hidden text-emerald-600">✓</span>
            </div>

            <label class="block text-sm sm:text-base font-heading font-extrabold text-heading leading-snug">
              {q.label}
            </label>
          </div>
          
          {q.subtitle && (
            <p class="text-xs font-medium text-slate-400 pl-7">
              {q.subtitle}
            </p>
          )}

          {q.helperText && (
            <p class="text-xs font-bold text-primary flex items-center gap-1 mt-1 pl-7">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary"></span> 
              {q.helperText}
            </p>
          )}
        </div>

        <!-- Single Choice Options Grid -->
        {q.type === "select" && q.options && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" data-question-id={q.id}>
            {q.options.map((opt) => (
              <div 
                class="option-card group relative flex cursor-pointer items-center justify-between rounded-xl border border-slate-200 bg-white p-3.5 shadow-3xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-400 hover:shadow-xs hover:bg-slate-50/50"
                data-type="select"
              >
                <div class="flex items-center gap-3">
                  <div class="radio-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2 border-slate-300 bg-slate-50 transition-all group-hover:border-primary">
                    <div class="radio-dot h-1.5 w-1.5 rounded-full bg-primary hidden"></div>
                  </div>

                  <span class="text-xs font-heading font-bold text-slate-700 group-hover:text-slate-900 leading-snug select-none">
                    {opt.label}
                  </span>
                </div>

                <input
                  type="radio"
                  name={q.id}
                  value={opt.value}
                  class="sr-only"
                />
              </div>
            ))}
          </div>
        )}

        <!-- Multi-Choice Options Grid -->
        {q.type === "multiselect" && q.options && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" data-question-id={q.id}>
            {q.options.map((opt) => (
              <div 
                class="option-card group relative flex cursor-pointer items-center justify-between rounded-xl border border-slate-200 bg-white p-3.5 shadow-3xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-400 hover:shadow-xs hover:bg-slate-50/50"
                data-type="multiselect"
              >
                <div class="flex items-center gap-3">
                  <div class="checkbox-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded border-2 border-slate-300 bg-slate-50 transition-all group-hover:border-primary">
                    <svg class="check-icon h-2.5 w-2.5 text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>

                  <span class="text-xs font-heading font-bold text-slate-700 group-hover:text-slate-900 leading-snug select-none">
                    {opt.label}
                  </span>
                </div>

                <input
                  type="checkbox"
                  name={q.id}
                  value={opt.value}
                  class="sr-only"
                />
              </div>
            ))}
          </div>
        )}

      </div>
    ))}
  </div>

  <!-- Industry Benchmark Note -->
  {section.didYouKnow && (
    <div class="rounded-xl border border-amber-200/80 bg-amber-50/60 p-3.5 flex items-start gap-3">
      <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-amber-100 text-amber-900 text-xs font-bold">
        📈
      </div>
      <div class="space-y-0.5">
        <span class="block text-3xs font-black uppercase tracking-widest text-amber-900">Industry Insight</span>
        <p class="text-xs font-body text-amber-950 leading-relaxed font-medium">
          {section.didYouKnow}
        </p>
      </div>
    </div>
  )}

  <!-- Form Footer Navigation -->
  <div class="flex items-center justify-between gap-4 pt-4 border-t border-slate-100">
    {stepNumber > 1 ? (
      <button
        type="button"
        data-action="prev"
        class="rounded-button border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-2xs transition hover:bg-slate-50 hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-200 cursor-pointer"
      >
        ← Back
      </button>
    ) : (
      <div></div>
    )}

    <button
      type="submit"
      data-action="next"
      class="rounded-button bg-primary px-6 py-3 text-xs font-black text-white shadow-sm transition hover:bg-primary-600 hover:shadow-md focus:outline-none focus:ring-4 focus:ring-primary-100 cursor-pointer"
    >
      {isLastStep ? "Generate Strategy Analysis →" : "Next Section →"}
    </button>
  </div>

</div>
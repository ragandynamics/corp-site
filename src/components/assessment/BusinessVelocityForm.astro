<form
  id="velocity-form"
  class="mx-auto max-w-3xl rounded-2xl bg-white p-8 shadow-lg space-y-8"
>

<div>
  <h2 class="text-2xl font-semibold text-gray-900">
    Business Information
  </h2>
  <p class="mt-2 text-sm text-gray-500">
    Tell us about your organisation.
  </p>
</div>

<div>
  <label class="mb-2 block text-sm font-medium text-gray-700">
    Company Name
  </label>
  <input
    name="company"
    required
    class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-blue-500 focus:ring-blue-500"
  />
</div>

<div>
  <label class="mb-2 block text-sm font-medium text-gray-700">
    Industry
  </label>
  <select
    name="industry"
    class="w-full rounded-lg border border-gray-300 px-4 py-3"
  >
    <option>Manufacturing</option>
    <option>Logistics</option>
    <option>Construction</option>
    <option>Professional Services</option>
    <option>Healthcare</option>
    <option>Retail</option>
    <option>Financial Services</option>
    <option>Other</option>
  </select>
</div>

<div>
  <label class="mb-2 block text-sm font-medium text-gray-700">
    Company Size
  </label>
  <select
    name="companySize"
    class="w-full rounded-lg border border-gray-300 px-4 py-3"
  >
    <option>1-10</option>
    <option>11-50</option>
    <option>51-200</option>
    <option>201-1000</option>
    <option>1000+</option>
  </select>
</div>

<div>
  <h2 class="text-2xl font-semibold">
    Business Challenges
  </h2>
  <div class="mt-4 grid gap-3 md:grid-cols-2">
    {
      [
        "Too much manual work",
        "Slow processes",
        "Customer service",
        "Sales follow-up",
        "Reporting",
        "Knowledge sharing",
        "Employee productivity",
        "Compliance",
        "Rising operating costs"
      ].map(item => (
        <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
          <input
            type="checkbox"
            name="challenges"
            value={item}
            class="h-4 w-4"
          />
          <span class="text-sm">{item}</span>
        </label>
      ))
    }
  </div>
</div>

<div>
  <h2 class="text-2xl font-semibold">
    Current Technology
  </h2>
  <div class="mt-4 grid gap-3 md:grid-cols-2">
    {
      [
        "Microsoft 365",
        "Google Workspace",
        "CRM",
        "ERP",
        "HRMS",
        "Accounting",
        "Custom Applications"
      ].map(item => (
        <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
          <input
            type="checkbox"
            name="systems"
            value={item}
            class="h-4 w-4"
          />
          <span class="text-sm">{item}</span>
        </label>
      ))
    }
  </div>
</div>

<div>
  <h2 class="text-2xl font-semibold">
    Business Priorities
  </h2>
  <div class="mt-4 grid gap-3 md:grid-cols-2">
    {
      [
        "Reduce costs",
        "Increase productivity",
        "Improve customer experience",
        "Grow revenue",
        "Improve compliance",
        "Scale operations"
      ].map(item => (
        <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
          <input
            type="checkbox"
            name="priorities"
            value={item}
            class="h-4 w-4"
          />
          <span class="text-sm">{item}</span>
        </label>
      ))
    }
  </div>
</div>

<div>
  <label class="mb-2 block font-medium">
    Implementation Timeline
  </label>
  <select
    name="timeline"
    class="w-full rounded-lg border px-4 py-3"
  >
    <option value="Immediately">Immediately</option>
    <option value="1-3 months">1-3 months</option>
    <option value="3-6 months">3-6 months</option>
    <option value="Exploring options">Exploring options</option>
  </select>
</div>

<div class="border-t pt-8 space-y-3">
  <h2 class="text-2xl font-semibold">
    Contact Details
  </h2>
  <input
    name="name"
    placeholder="Name"
    required
    class="w-full rounded-lg border px-4 py-3"
  />
  <input
    name="designation"
    placeholder="Designation"
    class="w-full rounded-lg border px-4 py-3"
  />
  <input
    name="email"
    type="email"
    placeholder="Business Email"
    required
    class="w-full rounded-lg border px-4 py-3"
  />
  <input
    name="phone"
    placeholder="Phone"
    class="w-full rounded-lg border px-4 py-3"
  />
</div>

<div class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-600 space-y-3">
  <p class="font-semibold text-slate-700">
    Personal Data Protection Act (PDPA) Notice
  </p>
  <p>
    By submitting this form, you consent to our collection, use, and disclosure of your personal data for the purpose of processing your assessment submission, preparing your customized report, and contacting you regarding our advisory services in accordance with our <a href="/privacy" class="text-blue-600 underline hover:text-blue-800" target="_blank">Privacy Policy</a>.
  </p>

  <label class="flex items-start gap-3 cursor-pointer pt-2">
    <input
      type="checkbox"
      name="pdpaConsent"
      id="pdpaConsent"
      required
      class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
    />
    <span class="text-slate-700 text-xs">
      I agree to the collection and processing of my personal data for the purposes stated above. <span class="text-red-500">*</span>
    </span>
  </label>
</div>

<div class="flex items-center gap-3 rounded-xl border border-blue-100 bg-blue-50/80 p-4 text-sm text-blue-900">
  <svg 
    class="h-5 w-5 shrink-0 text-blue-600" 
    fill="none" 
    stroke="currentColor" 
    viewBox="0 0 24 24" 
    xmlns="http://www.w3.org/2000/svg"
  >
    <path 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      stroke-width="2" 
      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
    ></path>
  </svg>
  <span>
    Our AI consultants will review your inputs and contact you within <strong>1 to 3 working days</strong>.
  </span>
</div>

<button
  type="submit"
  class="w-full rounded-xl bg-blue-600 px-6 py-4 text-lg font-semibold text-white hover:bg-blue-700 transition shadow-sm"
>
  Submit Discovery Assessment
</button>

</form>

<script>
const form = document.querySelector("#velocity-form") as HTMLFormElement | null;

form?.addEventListener("submit", async (e) => {
  e.preventDefault();

  const fd = new FormData(form);
  const data: any = {};

  fd.forEach((value, key) => {
    if (!data[key]) {
      data[key] = value;
    }
  });

  data.challenges = fd.getAll("challenges").map(String);
  data.systems = fd.getAll("systems").map(String);
  data.priorities = fd.getAll("priorities").map(String);
  data.pdpaConsent = fd.get("pdpaConsent") === "on";

  // Inverted Scoring logic: Lower score = Higher potential for improvement
  let currentEfficiency = 90;
  currentEfficiency -= data.challenges.length * 6;

  if (!data.systems.includes("ERP")) currentEfficiency -= 10;
  if (!data.systems.includes("CRM")) currentEfficiency -= 10;
  if (!data.systems.includes("HRMS")) currentEfficiency -= 5;

  if (data.timeline === "Exploring options") currentEfficiency -= 10;

  const finalScore = Math.min(Math.max(currentEfficiency, 10), 100);
  data.score = finalScore;

  try {
    const response = await fetch("/api/assessment", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(data),
    });

    if (response.ok) {
      window.location.href = `/assessment-success?score=${finalScore}`;
    } else {
      window.location.href = `/assessment-success?score=${finalScore}`;
    }
  } catch (err) {
    window.location.href = `/assessment-success?score=${finalScore}`;
  }
});
</script>
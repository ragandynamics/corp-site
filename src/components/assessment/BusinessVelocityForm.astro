---
import { assessmentOptions } from "../../lib/assessment/businessVelocitySubmission";
---

<form
  id="velocity-form"
  class="mx-auto max-w-3xl rounded-2xl bg-white p-8 shadow-lg space-y-8"
>

  <div>
    <h2 class="text-2xl font-semibold text-gray-900">
      Business Information
    </h2>
    <p class="mt-2 text-sm text-gray-500">
      Tell us about your organisation.
    </p>
  </div>

  <div>
    <label class="mb-2 block text-sm font-medium text-gray-700">
      Company Name <span class="text-red-500">*</span>
    </label>
    <input
      name="company"
      required
      class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-blue-500 focus:ring-blue-500"
    />
  </div>

  <div>
    <label class="mb-2 block text-sm font-medium text-gray-700">
      Industry
    </label>
    <select
      name="industry"
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    >
      {assessmentOptions.industries.map((industry) => <option value={industry}>{industry}</option>)}
    </select>
  </div>

  <div>
    <label class="mb-2 block text-sm font-medium text-gray-700">
      Company Size
    </label>
    <select
      name="companySize"
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    >
      {assessmentOptions.companySizes.map((size) => <option value={size}>{size}</option>)}
    </select>
  </div>

  <div id="section-challenges" class="rounded-xl p-4 transition-colors duration-200">
    <h2 class="text-2xl font-semibold text-gray-900">
      Business Challenges <span class="text-red-500 text-lg">*</span>
    </h2>
    <p class="text-sm text-gray-500 mt-1 mb-3">Select at least one challenge affecting your business.</p>
    <div class="grid gap-3 md:grid-cols-2">
      {
        assessmentOptions.challenges.map(item => (
          <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
            <input
              type="checkbox"
              name="challenges"
              value={item}
              class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            />
            <span class="text-sm">{item}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div id="section-systems" class="rounded-xl p-4 transition-colors duration-200">
    <h2 class="text-2xl font-semibold text-gray-900">
      Current Technology <span class="text-red-500 text-lg">*</span>
    </h2>
    <p class="text-sm text-gray-500 mt-1 mb-3">Select at least one platform or tool your organization uses.</p>
    <div class="grid gap-3 md:grid-cols-2">
      {
        assessmentOptions.systems.map(item => (
          <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
            <input
              type="checkbox"
              name="systems"
              value={item}
              class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            />
            <span class="text-sm">{item}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div id="section-priorities" class="rounded-xl p-4 transition-colors duration-200">
    <h2 class="text-2xl font-semibold text-gray-900">
      Business Priorities <span class="text-red-500 text-lg">*</span>
    </h2>
    <p class="text-sm text-gray-500 mt-1 mb-3">Select at least one priority for your organisation.</p>
    <div class="grid gap-3 md:grid-cols-2">
      {
        assessmentOptions.priorities.map(item => (
          <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
            <input
              type="checkbox"
              name="priorities"
              value={item}
              class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            />
            <span class="text-sm">{item}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div id="section-interests" class="rounded-xl p-4 transition-colors duration-200">
    <h2 class="text-2xl font-semibold text-gray-900">
      Solutions of Interest <span class="text-red-500 text-lg">*</span>
    </h2>
    <p class="text-sm text-gray-500 mt-1 mb-3">Select at least one solution area you would like to explore.</p>
    <div class="grid gap-3 md:grid-cols-2">
      {
        assessmentOptions.interests.map(item => (
          <label class="flex items-center gap-3 rounded-lg border p-3 hover:bg-gray-50 cursor-pointer">
            <input
              type="checkbox"
              name="interests"
              value={item}
              class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            />
            <span class="text-sm">{item}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div>
    <label class="mb-2 block font-medium text-gray-700">
      Implementation Timeline
    </label>
    <select
      name="timeline"
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    >
      {assessmentOptions.timelines.map((timeline) => <option value={timeline}>{timeline}</option>)}
    </select>
  </div>

  <div class="border-t pt-8 space-y-3">
    <h2 class="text-2xl font-semibold text-gray-900">
      Contact Details
    </h2>
    <input
      name="name"
      placeholder="Name *"
      required
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    />
    <input
      name="designation"
      placeholder="Designation"
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    />
    <input
      name="email"
      type="email"
      placeholder="Business Email *"
      required
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    />
    <input
      name="phone"
      placeholder="Phone"
      class="w-full rounded-lg border border-gray-300 px-4 py-3"
    />
  </div>

  <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-600 space-y-3">
    <p class="font-semibold text-slate-700">
      Personal Data Protection Act (PDPA) Notice
    </p>
    <p>
      By submitting this form, you consent to our collection, use, and disclosure of your personal data for the purpose of processing your assessment submission, preparing your customized report, and contacting you regarding our advisory services in accordance with our <a href="/privacy" class="text-blue-600 underline hover:text-blue-800" target="_blank">Privacy Policy</a>.
    </p>

    <label class="flex items-start gap-3 cursor-pointer pt-2">
      <input
        type="checkbox"
        name="pdpaConsent"
        id="pdpaConsent"
        required
        class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
      />
      <span class="text-slate-700 text-xs">
        I agree to the collection and processing of my personal data for the purposes stated above. <span class="text-red-500">*</span>
      </span>
    </label>
  </div>

  <div class="flex items-center gap-3 rounded-xl border border-blue-100 bg-blue-50/80 p-4 text-sm text-blue-900">
    <svg 
      class="h-5 w-5 shrink-0 text-blue-600" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      ></path>
    </svg>
    <span>
      Our AI consultants will review your inputs and contact you within <strong>1 to 3 working days</strong>.
    </span>
  </div>

  <div id="form-error" role="alert" aria-live="polite" class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"></div>

  <button
    type="submit"
    data-submit-button
    class="w-full rounded-xl bg-blue-600 px-6 py-4 text-lg font-semibold text-white hover:bg-blue-700 transition shadow-sm"
  >
    Submit Discovery Assessment
  </button>

</form>

<script>
import { calculateOperationalEfficiency } from "../../lib/assessment/businessVelocitySubmission";

const form = document.querySelector("#velocity-form") as HTMLFormElement | null;
const errorBox = document.querySelector("#form-error") as HTMLElement | null;
const submitButton = form?.querySelector<HTMLButtonElement>("[data-submit-button]") ?? null;

form?.addEventListener("submit", async (e) => {
  e.preventDefault();

  if (errorBox) {
    errorBox.classList.add("hidden");
    errorBox.textContent = "";
  }

  const fd = new FormData(form);

  const challenges = fd.getAll("challenges").map(String);
  const systems = fd.getAll("systems").map(String);
  const priorities = fd.getAll("priorities").map(String);
  const interests = fd.getAll("interests").map(String);

  // Reset visual error highlights
  ["section-challenges", "section-systems", "section-priorities", "section-interests"].forEach((id) => {
    document.getElementById(id)?.classList.remove("border-2", "border-red-500", "bg-red-50/30");
  });

  // Validate that each section has at least 1 checkbox selected
  const missingSections: { id: string; title: string }[] = [];

  if (challenges.length === 0) {
    missingSections.push({ id: "section-challenges", title: "Business Challenges" });
  }
  if (systems.length === 0) {
    missingSections.push({ id: "section-systems", title: "Current Technology" });
  }
  if (priorities.length === 0) {
    missingSections.push({ id: "section-priorities", title: "Business Priorities" });
  }
  if (interests.length === 0) {
    missingSections.push({ id: "section-interests", title: "Solutions of Interest" });
  }

  if (missingSections.length > 0) {
    // Highlight incomplete sections
    missingSections.forEach(({ id }) => {
      const container = document.getElementById(id);
      container?.classList.add("border-2", "border-red-500", "bg-red-50/30");
    });

    // Display error notification
    const labels = missingSections.map((s) => s.title).join(", ");
    if (errorBox) {
      errorBox.textContent = `Please select at least one option for: ${labels}.`;
      errorBox.classList.remove("hidden");
    }

    // Smooth scroll to the first missing section
    document.getElementById(missingSections[0].id)?.scrollIntoView({ behavior: "smooth", block: "center" });
    return;
  }

  const data: Record<string, FormDataEntryValue | FormDataEntryValue[] | boolean | number> = {};
  fd.forEach((value, key) => {
    if (!data[key]) {
      data[key] = value;
    }
  });

  data.challenges = challenges;
  data.systems = systems;
  data.priorities = priorities;
  data.interests = interests;
  data.pdpaConsent = fd.get("pdpaConsent") === "on";

  const finalScore = calculateOperationalEfficiency({
    challenges,
    systems,
    timeline: String(data.timeline),
  });

  try {
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Submitting…";
    }

    const response = await fetch("/api/assessment", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(data),
    });

    const result = (await response.json().catch(() => ({}))) as { error?: string; score?: number };
    if (response.ok) {
      const serverScore = typeof result.score === "number" ? result.score : finalScore;
      window.location.href = `/assessment-success?score=${serverScore}`;
      return;
    }

    if (errorBox) {
      errorBox.textContent = result.error || "We could not submit your assessment. Please try again.";
      errorBox.classList.remove("hidden");
    }
  } catch {
    if (errorBox) {
      errorBox.textContent = "We could not connect to the service. Please check your connection and try again.";
      errorBox.classList.remove("hidden");
    }
  } finally {
    if (submitButton) {
      submitButton.disabled = false;
      submitButton.textContent = "Submit Discovery Assessment";
    }
  }
});
</script>

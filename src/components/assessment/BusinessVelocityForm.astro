<form
id="velocity-form"
class="mx-auto max-w-3xl rounded-2xl bg-white p-8 shadow-lg space-y-8"
>


<div>

<h2 class="text-2xl font-semibold text-gray-900">
Business Information
</h2>

<p class="mt-2 text-sm text-gray-500">
Tell us about your organisation.
</p>

</div>



<div>

<label class="mb-2 block text-sm font-medium text-gray-700">
Company Name
</label>


<input
name="company"
required
class="
w-full rounded-lg border border-gray-300
px-4 py-3
focus:border-blue-500
focus:ring-blue-500
"
/>

</div>




<div>

<label class="mb-2 block text-sm font-medium text-gray-700">
Industry
</label>


<select
name="industry"
class="
w-full rounded-lg border border-gray-300
px-4 py-3
"
>


<option>Manufacturing</option>
<option>Logistics</option>
<option>Construction</option>
<option>Professional Services</option>
<option>Healthcare</option>
<option>Retail</option>
<option>Financial Services</option>
<option>Other</option>


</select>


</div>





<div>

<label class="mb-2 block text-sm font-medium text-gray-700">
Company Size
</label>


<select
name="companySize"
class="
w-full rounded-lg border border-gray-300
px-4 py-3
"
>


<option>1-10</option>
<option>11-50</option>
<option>51-200</option>
<option>201-1000</option>
<option>1000+</option>


</select>

</div>




<div>


<h2 class="text-2xl font-semibold">
Business Challenges
</h2>



<div class="mt-4 grid gap-3 md:grid-cols-2">


{

[
"Too much manual work",
"Slow processes",
"Customer service",
"Sales follow-up",
"Reporting",
"Knowledge sharing",
"Employee productivity",
"Compliance",
"Rising operating costs"
]

.map(item => (

<label
class="
flex items-center gap-3
rounded-lg border
p-3
hover:bg-gray-50
cursor-pointer
"
>

<input
type="checkbox"
name="challenges"
value={item}
class="h-4 w-4"
/>


<span class="text-sm">
{item}
</span>


</label>


))

}


</div>


</div>





<div>


<h2 class="text-2xl font-semibold">
Current Technology
</h2>



<div class="mt-4 grid gap-3 md:grid-cols-2">


{

[
"Microsoft 365",
"Google Workspace",
"CRM",
"ERP",
"HRMS",
"Accounting",
"Custom Applications"
]

.map(item => (

<label
class="
flex items-center gap-3
rounded-lg border
p-3
hover:bg-gray-50
cursor-pointer
"
>

<input
type="checkbox"
name="systems"
value={item}
class="h-4 w-4"
/>


<span class="text-sm">
{item}
</span>


</label>


))

}


</div>


</div>





<div>


<h2 class="text-2xl font-semibold">
Business Priorities
</h2>


<div class="mt-4 grid gap-3 md:grid-cols-2">


{

[
"Reduce costs",
"Increase productivity",
"Improve customer experience",
"Grow revenue",
"Improve compliance",
"Scale operations"
]

.map(item => (

<label
class="
flex items-center gap-3
rounded-lg border
p-3
hover:bg-gray-50
cursor-pointer
"
>


<input
type="checkbox"
name="priorities"
value={item}
class="h-4 w-4"
/>


<span class="text-sm">
{item}
</span>


</label>


))


}


</div>


</div>





<div>

<label class="mb-2 block font-medium">
Implementation Timeline
</label>


<select
name="timeline"
class="
w-full rounded-lg border
px-4 py-3
"
>

<option>
Immediately
</option>

<option>
1-3 months
</option>

<option>
3-6 months
</option>

<option>
Exploring options
</option>


</select>


</div>





<div class="border-t pt-8">


<h2 class="text-2xl font-semibold">
Contact Details
</h2>


<input
name="name"
placeholder="Name"
required
class="mt-4 w-full rounded-lg border px-4 py-3"
/>



<input
name="designation"
placeholder="Designation"
class="mt-3 w-full rounded-lg border px-4 py-3"
/>



<input
name="email"
type="email"
placeholder="Business Email"
required
class="mt-3 w-full rounded-lg border px-4 py-3"
/>



<input
name="phone"
placeholder="Phone"
class="mt-3 w-full rounded-lg border px-4 py-3"
/>


</div>





<button
type="submit"
class="
w-full rounded-xl
bg-blue-600
px-6 py-4
text-lg font-semibold
text-white
hover:bg-blue-700
transition
"
>

Submit Business Discovery

</button>


</form>



<script>

const form =
document.querySelector(
"#velocity-form"
) as HTMLFormElement | null;



form?.addEventListener(
"submit",
async(e)=>{


e.preventDefault();



const fd =
new FormData(form);



const data:any = {};



fd.forEach(
(value,key)=>{

if(!data[key])
{
data[key]=value;
}

});



data.challenges =
fd.getAll("challenges")
.map(String);



data.systems =
fd.getAll("systems")
.map(String);



data.priorities =
fd.getAll("priorities")
.map(String);



const response =
await fetch(
"/api/assessment",
{

method:"POST",

headers:{
"Content-Type":
"application/json"
},

body:
JSON.stringify(data)

}
);



if(response.ok)
{

window.location.href =
"/assessment-success";

}


});


</script>
---
// src/components/assessment/AssessmentResults.astro

export interface AssessmentAnswers {
  companySize?: string;
  industry?: string;
  bottlenecks?: string[];
  currentTools?: string[];
  primaryGoal?: string;
}

export interface Props {
  answers?: AssessmentAnswers;
}

const answers: AssessmentAnswers = Astro.props.answers ?? {};
const industry = answers.industry || "Your Business";
---

<div class="mx-auto max-w-4xl space-y-12 py-8 px-4 sm:px-6">

  <!-- Hero Header -->
  <section class="text-center space-y-4 border-b border-slate-200 pb-8">
    <span class="inline-block rounded-full bg-blue-100 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-blue-800">
      Personalized Strategy Report
    </span>
    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
      Your AI Transformation Opportunity
    </h1>
    <p class="mx-auto max-w-2xl text-base text-slate-600 leading-relaxed">
      Based on your operational assessment for {industry}, we've mapped out where AI creates the greatest business value without operational disruption.
    </p>
  </section>

  <!-- Qualitative Opportunity Breakdown -->
  <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm space-y-6">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900">Overall Business Opportunity</h2>
        <p class="text-xs text-slate-500">Qualitative potential based on your time-drains and tech stack.</p>
      </div>
      <span class="rounded-full bg-blue-600 px-4 py-1.5 text-xs font-extrabold text-white">
        High Potential
      </span>
    </div>

    <!-- Star Ratings & Explanations -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-900 text-sm">Knowledge Management</span>
          <span class="text-yellow-500 font-black">★★★★★</span>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          High impact potential. Indexing company documents and communications allows employees to query SOPs and contracts instantly.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-900 text-sm">Workflow Automation</span>
          <span class="text-yellow-500 font-black">★★★★★</span>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          High impact potential. Connecting repetitive data-entry and email classification directly to your CRM/ERP eliminates administrative re-work.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-900 text-sm">Customer Experience</span>
          <span class="text-yellow-500 font-black">★★★★☆</span>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Strong potential. Draft intelligent responses and route complex customer inquiries automatically.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-900 text-sm">Internal Productivity</span>
          <span class="text-yellow-500 font-black">★★★★☆</span>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Strong potential. Deploy internal copilots for proposal drafting and meeting summaries.
        </p>
      </div>
    </div>
  </section>

  <!-- Final Business Conversation CTA -->
  <section class="rounded-3xl bg-slate-900 p-8 sm:p-12 text-white text-center space-y-8 shadow-xl">
    <div class="space-y-3 max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-4xl font-black tracking-tight">
        Let's Discuss Your Results
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        In a complimentary 60-minute strategy session, we will turn this assessment into a practical execution plan.
      </p>
    </div>

    <!-- Workshop Deliverables -->
    <div class="max-w-xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3 text-left text-xs sm:text-sm text-slate-300 bg-slate-800/80 p-6 rounded-2xl border border-slate-700">
      <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold">✓</span> Review your custom assessment
      </div>
      <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold">✓</span> Prioritize high-impact AI opportunities
      </div>
      <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold">✓</span> Recommend practical next steps
      </div>
      <div class="flex items-center gap-2">
        <span class="text-blue-400 font-bold">✓</span> Map integrations with existing tools
      </div>
      <div class="flex items-center gap-2 sm:col-span-2">
        <span class="text-blue-400 font-bold">✓</span> Outline a realistic implementation roadmap
      </div>
    </div>

    <div>
      <a
        href="/contact"
        class="inline-block rounded-xl bg-blue-600 px-8 py-4 text-base font-bold text-white shadow-lg transition hover:bg-blue-500 focus:ring-4 focus:ring-blue-400"
      >
        Schedule My AI Strategy Session →
      </a>
    </div>
  </section>

</div>
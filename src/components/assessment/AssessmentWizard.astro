---
// AssessmentWizard.astro
import AssessmentResults from './AssessmentResults.astro';
---

<div class="w-full max-w-4xl mx-auto py-8">
  <!-- Wizard Form Steps -->
  <div id="assessment-wizard-container">
    <form id="wizard-form" class="space-y-6">
      
      <!-- Step 1: Company Context -->
      <div class="wizard-step" data-step="1">
        <h3 class="text-xl font-semibold text-white mb-4">Step 1: Organization Size</h3>
        <label class="block text-sm text-slate-300 mb-2">Select your team size:</label>
        <select name="company_size" class="w-full p-3 rounded-lg bg-slate-800 text-white border border-slate-700">
          <option value="1-10">1–10 employees</option>
          <option value="11-50">11–50 employees</option>
          <option value="51-100">51–100 employees</option>
          <option value="100+">100+ employees</option>
        </select>
      </div>

      <!-- Step 2: Implementation Timeline -->
      <div class="wizard-step hidden" data-step="2">
        <h3 class="text-xl font-semibold text-white mb-4">Step 2: Target Timeline</h3>
        <label class="block text-sm text-slate-300 mb-2">When are you looking to deploy?</label>
        <select name="timeline" class="w-full p-3 rounded-lg bg-slate-800 text-white border border-slate-700">
          <option value="immediate">Immediate / Next 30 Days</option>
          <option value="1-3 months">1–3 Months</option>
          <option value="3-6 months">3–6 Months</option>
          <option value="exploring">6+ Months / Planning</option>
        </select>
      </div>

      <!-- Step 3: Estimated Budget -->
      <div class="wizard-step hidden" data-step="3">
        <h3 class="text-xl font-semibold text-white mb-4">Step 3: Estimated Budget</h3>
        <label class="block text-sm text-slate-300 mb-2">Select allocated budget range:</label>
        <select name="budget" class="w-full p-3 rounded-lg bg-slate-800 text-white border border-slate-700">
          <option value="under-10k">Under $10k</option>
          <option value="10k-50k">$10k – $50k</option>
          <option value="50k-100k">$50k – $100k</option>
          <option value="100k+">$100k+</option>
        </select>
      </div>

      <!-- Navigation Controls -->
      <div class="flex justify-between items-center pt-6 border-t border-slate-800">
        <button 
          type="button" 
          id="prev-btn" 
          class="hidden px-5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm font-medium"
        >
          Previous
        </button>
        <button 
          type="button" 
          id="next-btn" 
          class="ml-auto px-6 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition-colors"
        >
          Next
        </button>
      </div>
    </form>
  </div>

  <!-- Step 4: Results Display Container -->
  <div id="results-container" class="hidden">
    <AssessmentResults />
  </div>
</div>

<script>
  function setupWizard() {
    const form = document.getElementById('wizard-form') as HTMLFormElement;
    const steps = Array.from(document.querySelectorAll('.wizard-step')) as HTMLElement[];
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const wizardContainer = document.getElementById('assessment-wizard-container');
    const resultsContainer = document.getElementById('results-container');

    if (!form || steps.length === 0) return;

    let currentStep = 0;

    function updateStepVisibility() {
      steps.forEach((step, index) => {
        step.classList.toggle('hidden', index !== currentStep);
      });

      if (prevBtn) {
        prevBtn.classList.toggle('hidden', currentStep === 0);
      }

      if (nextBtn) {
        nextBtn.textContent = currentStep === steps.length - 1 ? 'View Results' : 'Next';
      }
    }

    function saveCurrentStepData() {
      const formData = new FormData(form);
      const existingData = JSON.parse(localStorage.getItem('assessment_data') || '{}');
      
      formData.forEach((value, key) => {
        existingData[key] = value;
      });

      localStorage.setItem('assessment_data', JSON.stringify(existingData));
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        saveCurrentStepData();

        if (currentStep < steps.length - 1) {
          currentStep++;
          updateStepVisibility();
        } else {
          // Final step completed: show results container
          if (wizardContainer) wizardContainer.classList.add('hidden');
          if (resultsContainer) resultsContainer.classList.remove('hidden');

          // Trigger update in AssessmentResults component
          window.dispatchEvent(new CustomEvent('renderResults'));
        }
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentStep > 0) {
          currentStep--;
          updateStepVisibility();
        }
      });
    }

    updateStepVisibility();
  }

  document.addEventListener('astro:page-load', setupWizard);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupWizard();
  }
</script>
---
// AssessmentQuestion.astro

export interface QuestionOption {
  label: string;
  value: string;
}

export interface Question {
  id: string;
  label: string;
  required?: boolean;
  hasOtherOption?: boolean;
  options: QuestionOption[];
}

interface Props {
  question: Question;
}

const { question } = Astro.props;
---

<div 
  class="assessment-question space-y-3" 
  data-question-id={question.id} 
  data-required={question.required ? "true" : "false"}
  data-has-other={question.hasOtherOption ? "true" : "false"}
>
  <label class="block text-sm font-bold text-slate-900">
    {question.label}
    {question.required && <span class="text-rose-500 ml-1">*</span>}
  </label>

  <!-- Answer Options -->
  <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
    {question.options.map((opt: QuestionOption) => (
      <button
        type="button"
        class="answer-option flex items-center justify-between border border-slate-200 rounded-xl p-3 text-left text-xs font-medium text-slate-700 hover:border-blue-500 transition"
        data-answer={opt.value}
      >
        <span>{opt.label}</span>
      </button>
    ))}
  </div>

  <!-- Dynamic "Other" Text Input -->
  {question.hasOtherOption && (
    <div class="other-input-container hidden mt-2">
      <input
        type="text"
        class="other-text-input w-full p-3 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none"
        placeholder="Please specify..."
        data-question-id={question.id}
      />
    </div>
  )}

  <!-- Missing Required Field Validation Message -->
  <p class="error-msg hidden text-xs font-semibold text-rose-500">
    This question is required.
  </p>
</div>
---
const { score } = Astro.props;
---

<section class="py-16 text-center">
  <h1 class="text-3xl font-bold">Your AI Efficiency Health Check Results</h1>
  <p class="mt-4 text-lg text-gray-600">
    Based on your responses, your business efficiency score is <strong>{score}/100</strong>.
  </p>

  {score >= 80 && (
    <p class="mt-6 text-green-600 font-semibold">
      High potential: You’re ready for immediate AI transformation.
    </p>
  )}
  {score >= 50 && score < 80 && (
    <p class="mt-6 text-yellow-600 font-semibold">
      Moderate potential: Targeted AI interventions can unlock quick wins.
    </p>
  )}
  {score < 50 && (
    <p class="mt-6 text-red-600 font-semibold">
      Low potential: Focus on building AI readiness before scaling.
    </p>
  )}

  <div class="mt-10">
    <a href="/book-consultation"
       class="rounded-xl bg-blue-600 px-6 py-4 text-lg font-semibold text-white hover:bg-blue-700">
       Book Your AI Transformation Consultation
    </a>
  </div>
</section>

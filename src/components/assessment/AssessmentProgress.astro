---
interface Props {
  step: number;
  total: number;
}

const { step, total } = Astro.props;

const percentage =
  Math.round((step / total) * 100);

const steps = Array.from(
  { length: total },
  (_, i) => i + 1
);
---

<div
  id="progress"
  class="mb-10"
>
  <!-- Header -->

  <div class="mb-4 flex items-center justify-between">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-blue-600">
        AI Readiness Assessment
      </p>

      <h2 class="text-lg font-semibold text-slate-900">
        Step {step} of {total}
      </h2>
    </div>

    <div
      class="rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700"
    >
      {percentage}%
    </div>
  </div>

  <!-- Progress Bar -->

  <div
    class="h-3 overflow-hidden rounded-full bg-slate-200"
  >
    <div
      id="progress-bar"
      class="h-full rounded-full bg-blue-600 transition-all duration-500 ease-in-out"
      style={`width:${percentage}%`}
    />
  </div>

  <!-- Step Indicators -->

  <div
    class="mt-6 grid grid-cols-7 gap-2"
  >
    {
      steps.map((item) => {
        const completed =
          item < step;

        const current =
          item === step;

        return (
          <div
            class="flex flex-col items-center gap-2"
          >
            <div
              class:list={[
                "flex h-10 w-10 items-center justify-center rounded-full border text-sm font-semibold transition-all duration-300",

                completed &&
                  "border-blue-600 bg-blue-600 text-white",

                current &&
                  "border-blue-600 bg-white text-blue-600 ring-4 ring-blue-100",

                !completed &&
                  !current &&
                  "border-slate-300 bg-white text-slate-500",
              ]}
            >
              {completed ? "✓" : item}
            </div>

            <div
              class="hidden text-center text-xs text-slate-500 md:block"
            >
              {
                [
                  "Profile",
                  "Challenges",
                  "Technology",
                  "AI",
                  "Goals",
                  "Contact",
                  "Results",
                ][item - 1]
              }
            </div>
          </div>
        );
      })
    }
  </div>
</div>
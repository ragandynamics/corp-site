---
import Container from "../ui/Container.astro";
import { site } from "../../config/site";

const { company } = site;
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-blue-900">

  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,#2563eb22,transparent_40%)]"></div>

  <Container>

    <div class="relative grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-24">

      <!-- ================================================= -->
      <!-- Left -->
      <!-- ================================================= -->

      <div>

        <span
          class="inline-flex items-center rounded-full bg-blue-600/20 px-4 py-2 text-sm font-semibold text-blue-300"
        >
          🇸🇬 {company.tagline}
        </span>

        <h1 class="mt-8 text-3xl font-black leading-tight text-white sm:text-5xl lg:text-6xl">

          Practical AI for Singapore SMEs

          <span class="block text-blue-400">
            Work Smarter. Grow Faster.
          </span>

        </h1>

        <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl sm:leading-9">

          We help Singapore SMEs automate repetitive work, improve customer
          service and turn business data into better decisions—with secure,
          practical AI solutions built around measurable outcomes.

        </p>

        <div class="mt-10 flex flex-wrap gap-4">

          <a
            href="/assessment"
            data-analytics="hero-assessment"
            class="rounded-xl bg-blue-600 px-8 py-4 text-lg font-bold text-white transition hover:bg-blue-700"
          >
            Get Your Free AI Assessment
          </a>

          <a
            href="/services"
            class="rounded-xl border border-white px-8 py-4 text-lg font-semibold text-white transition hover:bg-white hover:text-slate-900"
          >
            Explore Our Services
          </a>

        </div>

        <div class="mt-12 hidden grid-cols-2 gap-6 border-t border-white/10 pt-8 sm:grid md:grid-cols-4">

          <div>

            <div class="text-3xl font-black text-blue-400">
              SME
            </div>

            <p class="mt-2 text-sm text-slate-300">
              Focused
            </p>

          </div>

          <div>

            <div class="text-3xl font-black text-blue-400">
              Secure
            </div>

            <p class="mt-2 text-sm text-slate-300">
              by Design
            </p>

          </div>

          <div>

            <div class="text-3xl font-black text-blue-400">
              Practical
            </div>

            <p class="mt-2 text-sm text-slate-300">
              Delivery
            </p>

          </div>

          <div>

            <div class="text-3xl font-black text-blue-400">
              ROI
            </div>

            <p class="mt-2 text-sm text-slate-300">
              Business Focused
            </p>

          </div>

        </div>

      </div>

      <!-- ================================================= -->
      <!-- Right -->
      <!-- ================================================= -->

      <div>

        <div class="rounded-3xl bg-white p-8 shadow-2xl lg:p-10">

          <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-700">
            Free · About 3 minutes
          </span>

          <h2 class="mt-5 text-3xl font-black text-slate-900">

            Find Your Best AI Opportunity

          </h2>

          <p class="mt-4 leading-7 text-slate-600">
            Answer a few practical questions and receive a focused view of
            where AI and automation could create value in your business.
          </p>

          <ul class="mt-7 space-y-4 text-slate-700">
            <li class="flex gap-3"><span class="font-bold text-emerald-600">✓</span> Identify high-impact use cases</li>
            <li class="flex gap-3"><span class="font-bold text-emerald-600">✓</span> Understand your readiness level</li>
            <li class="flex gap-3"><span class="font-bold text-emerald-600">✓</span> Receive recommended next steps</li>
          </ul>

          <a
            href="/assessment"
            class="mt-8 flex min-h-12 w-full items-center justify-center rounded-xl bg-slate-900 px-6 py-4 text-center font-bold text-white transition hover:bg-blue-700"
          >
            Start My Assessment
          </a>

        </div>

      </div>

    </div>

  </Container>

</section>

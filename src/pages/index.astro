---
import MainLayout from "../layouts/MainLayout.astro";

import { site } from "../config/site";

import Hero from "../components/home/Hero.astro";
import BusinessChallenges from "../components/home/BusinessChallenges.astro";
import Services from "../components/home/Services.astro";
import Products from "../components/home/Products.astro";
import WhyRaganDynamics from "../components/home/WhyRaganDynamics.astro";
import TransformationJourney from "../components/home/TransformationJourney.astro";
import Insights from "../components/home/Insights.astro";
import FAQ from "../components/home/FAQ.astro";
import ContactCTA from "../components/home/ContactCTA.astro";

const company = site?.company ?? { name: "RaganDynamics" };
---

<MainLayout
  title={`${company.name} | AI Consulting & Automation for Singapore SMEs`}
  description="Helping Singapore SMEs reduce costs, improve productivity and accelerate growth through practical, secure and cost-effective AI solutions."
>
  <Hero />
  <BusinessChallenges />
  <Services />
  <WhyRaganDynamics />
  <TransformationJourney />
  <Products />
  <Insights />
  <FAQ />
  <ContactCTA />
</MainLayout>

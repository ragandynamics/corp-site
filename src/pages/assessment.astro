---
import MainLayout from "../layouts/MainLayout.astro";
import BusinessVelocityForm from "../components/assessment/BusinessVelocityForm.astro";
---

<MainLayout
  title="Business Velocity Discovery"
  description="Discover AI opportunities for your business"
>

<section class="py-16">

  <div class="mx-auto max-w-5xl px-6">


    <div class="mb-12 text-center">

      <h1 class="text-4xl font-bold tracking-tight text-gray-900">
        Business Velocity Discovery
      </h1>


      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">

        Discover where AI can improve productivity,
        reduce costs and accelerate business growth.

      </p>


      <p class="mt-3 text-sm text-gray-500">

        Complete this 3-minute executive discovery questionnaire.

      </p>


    </div>


    <BusinessVelocityForm />


  </div>

</section>


</MainLayout>
---
import MainLayout from "../layouts/MainLayout.astro";
import BusinessVelocityForm from "../components/assessment/BusinessVelocityForm.astro";
---

<MainLayout
  title="Free AI Opportunity Assessment | RaganDynamics"
  description="Identify practical AI and automation opportunities for your business in about three minutes."
>

<section class="bg-slate-50 py-14 sm:py-20">

  <div class="mx-auto max-w-5xl px-6">


    <div class="mb-12 text-center">

      <span class="inline-flex rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700">
        Free Business Velocity Discovery
      </span>

      <h1 class="mt-6 text-3xl font-black tracking-tight text-slate-900 sm:text-5xl">
        Find the AI Opportunities Most Relevant to Your Business
      </h1>


      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">

        Get a focused view of where AI can improve productivity, reduce
        operating friction and support growth—without starting with technology.

      </p>


      <div class="mt-6 flex justify-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/80 px-4 py-2 text-sm font-medium text-blue-900 shadow-sm backdrop-blur-sm transition-all hover:bg-blue-100/70">
          <svg 
            class="h-4 w-4 text-blue-600 animate-pulse" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24" 
            xmlns="http://www.w3.org/2000/svg"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>No technical knowledge required · About 3 minutes</span>
        </div>
      </div>


    </div>


    <BusinessVelocityForm />


  </div>

</section>


</MainLayout>

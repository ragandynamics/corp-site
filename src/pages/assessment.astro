---
import MainLayout from "../layouts/MainLayout.astro";
import BusinessVelocityForm from "../components/assessment/BusinessVelocityForm.astro";
---

<MainLayout
  title="AI Transformation Assessment Form"
  description="Discover AI opportunities for your business"
>

<section class="py-16">

  <div class="mx-auto max-w-5xl px-6">


    <div class="mb-12 text-center">

      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        AI Transformation Assessment Form
      </h1>


      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">

        Discover where AI can improve productivity,
        reduce costs and accelerate business growth.

      </p>


      <div class="mt-6 flex justify-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50/80 px-4 py-2 text-sm font-medium text-blue-900 shadow-sm backdrop-blur-sm transition-all hover:bg-blue-100/70">
          <svg 
            class="h-4 w-4 text-blue-600 animate-pulse" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24" 
            xmlns="http://www.w3.org/2000/svg"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Complete this 3-minute executive discovery questionnaire.</span>
        </div>
      </div>


    </div>


    <BusinessVelocityForm />


  </div>

</section>


</MainLayout>
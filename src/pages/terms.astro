---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Website Terms of Use | RaganDynamics"
  description="Terms governing the use of the RaganDynamics website and its informational resources."
>
  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <span class="text-sm font-semibold uppercase tracking-widest text-blue-700">Legal</span>
      <h1 class="mt-4 text-3xl font-black text-slate-900 sm:text-5xl">Website Terms of Use</h1>
      <p class="mt-5 text-lg text-slate-600">Last updated: 13 October 2026</p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-4xl space-y-10 px-6 leading-8 text-slate-700">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Using this website</h2>
        <p class="mt-3">
          This website provides general information about RaganDynamics, our services and our products.
          You may use it for lawful business and informational purposes.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Information and recommendations</h2>
        <p class="mt-3">
          Website content and assessment results are indicative and do not constitute professional,
          legal, financial or regulatory advice. Project recommendations are confirmed only through a
          written engagement agreed with RaganDynamics.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Intellectual property</h2>
        <p class="mt-3">
          Unless otherwise stated, website content, branding and original materials belong to
          RaganDynamics. They may not be reproduced or used commercially without written permission.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Third-party services</h2>
        <p class="mt-3">
          Links to third-party websites and products are provided for convenience. Their availability,
          content and privacy practices are controlled by their respective providers.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Privacy</h2>
        <p class="mt-3">
          Personal data submitted through this website is handled as described in our
          <a href="/privacy" class="font-semibold text-blue-700 underline hover:text-blue-900">Privacy Policy</a>.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Contact</h2>
        <p class="mt-3">
          Questions about these terms may be submitted through our
          <a href="/contact" class="font-semibold text-blue-700 underline hover:text-blue-900">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</MainLayout>

---
import MainLayout from "../layouts/MainLayout.astro";
import Industries from "../components/home/Industries.astro";
---

<MainLayout
  title="AI Solutions by Industry | RaganDynamics"
  description="Practical AI consulting and automation solutions for Singapore SMEs across manufacturing, professional services, distribution, logistics, healthcare and retail."
>
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-700/20 via-indigo-600/10 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24">
      <span class="inline-flex rounded-full border border-blue-400/30 bg-blue-500/10 px-4 py-2 text-sm font-semibold text-blue-200">
        Industry-focused transformation
      </span>
      <h1 class="mt-7 max-w-4xl text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">
        Practical AI Built Around the Way Your Industry Works
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">
        We start with the workflows, constraints and customer expectations specific
        to your sector—then identify the AI opportunities most likely to create value.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/assessment" class="rounded-xl bg-blue-600 px-7 py-4 font-bold text-white transition hover:bg-blue-700">
          Get Your Free AI Assessment
        </a>
        <a href="/contact" class="rounded-xl border border-white/40 px-7 py-4 font-bold text-white transition hover:bg-white hover:text-slate-950">
          Discuss Your Industry
        </a>
      </div>
    </div>
  </section>

  <Industries />
</MainLayout>

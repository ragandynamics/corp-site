---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import MobileMenu from "../components/layout/MobileMenu.astro";
import SEOHead from "../components/layout/SEOHead.astro";
import CloudflareAnalytics from "../components/analytics/CloudflareAnalytics.astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image
} = Astro.props;

const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEOHead
      title={title}
      description={description}
      image={image}
    />

    {/* Only inject Cloudflare Analytics in production */}
    {import.meta.env.PROD && analyticsToken && (
      <CloudflareAnalytics token={analyticsToken} />
    )}

    <link
      rel="icon"
      href="/favicon.svg"
    />
  </head>

  <body
    class="
      min-h-screen
      bg-white
      text-slate-600
      antialiased
    "
  >
    <a
      href="#main-content"
      class="sr-only fixed left-4 top-4 z-[200] rounded-lg bg-slate-950 px-4 py-3 font-semibold text-white focus:not-sr-only"
    >
      Skip to main content
    </a>
    <Navbar />
    <MobileMenu />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
